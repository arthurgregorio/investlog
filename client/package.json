{
  "name": "investlog",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "InvestLog — the investments logbook",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
    "test": "vitest",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "axios": "^1.18.0",
    "buefy": "^3.0.8",
    "chart.js": "^4.5.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.4",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.3.3",
    "typescript": "~5.6.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-tsc": "^2.1.10"
  }
}
