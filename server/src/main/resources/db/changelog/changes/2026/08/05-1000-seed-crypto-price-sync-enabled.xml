<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="05-1000-1" author="${claude}">
        <comment>Seed crypto_price_sync_enabled, defaulting the automated crypto sync job to on</comment>
        <sql>
            INSERT INTO system.configurations (key, value) VALUES ('crypto_price_sync_enabled', 'true');
        </sql>
        <rollback>
            <sql>
                DELETE FROM system.configurations WHERE key = 'crypto_price_sync_enabled';
            </sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
