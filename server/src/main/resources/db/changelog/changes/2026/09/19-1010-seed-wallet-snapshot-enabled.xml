<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="19-1010-1" author="${claude}">
        <comment>Seed wallet_snapshot_enabled, defaulting the end-of-day wallet snapshot job to off</comment>
        <sql>
            INSERT INTO system.configurations (key, value) VALUES ('wallet_snapshot_enabled', 'false');
        </sql>
        <rollback>
            <sql>
                DELETE FROM system.configurations WHERE key = 'wallet_snapshot_enabled';
            </sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
